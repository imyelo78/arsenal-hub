# API-Football key (get free at https://www.api-football.com/)
# Free plan: 100 requests/day, seasons 2022-2024 only
API_FOOTBALL_KEY=

# football-data.org key (get free at https://www.football-data.org/)
# Free plan: 10 requests/minute, 12 competitions, current season
# Supports current season live data (recommended for fixtures & standings)
FOOTBALL_DATA_KEY=

# Public base URLs (no need to change)
NUXT_PUBLIC_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
NUXT_PUBLIC_FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
